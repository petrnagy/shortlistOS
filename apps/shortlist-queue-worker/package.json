{
  "name": "@kan/shortlist-queue-worker",
  "private": true,
  "version": "0.1.0",
  "description": "shortlistOS background workers for capture and enrichment jobs.",
  "type": "module",
  "exports": {
    "./enrichment": "./src/enrichment.ts"
  },
  "scripts": {
    "build": "tsc",
    "dev": "node -e \"console.log('shortlist-queue-worker dev does not start processors. Run pnpm process-sources explicitly.')\"",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "process-sources": "dotenv -e ../../.env -- tsx src/jobs/process-sources.ts",
    "process-clip": "dotenv -e ../../.env -- tsx src/jobs/process-clip.ts",
    "process-inbox": "dotenv -e ../../.env -- tsx src/jobs/process-inbox.ts",
    "start": "dotenv -e ../../.env -- tsx src/index.ts",
    "test:pipeline": "dotenv -e ../../.env -- vitest run live-tests",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "author": "Petr Nagy / shortlistOS",
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@kan/db": "workspace:^",
    "@kan/llm": "workspace:*",
    "@kan/logger": "workspace:^",
    "@kan/shared": "workspace:^",
    "dotenv-cli": "^7.4.4",
    "drizzle-orm": "^0.42.0",
    "officeparser": "^7.3.0",
    "tsx": "^4.20.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@kan/eslint-config": "workspace:*",
    "@kan/prettier-config": "workspace:*",
    "@kan/tsconfig": "workspace:*",
    "@types/node": "^20.17.7",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "^3.0.0"
  },
  "prettier": "@kan/prettier-config"
}
