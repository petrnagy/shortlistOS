# https://github.com/kanbn/kan?tab=readme-ov-file#environment-variables-)

# Required environment variables
NEXT_PUBLIC_BASE_URL= # e.g. https://kan.bn
NEXT_PUBLIC_LANDING_PAGE_URL= # e.g. https://example.com, used by homepage links when the app runs on a subdomain
NEXT_PUBLIC_GITHUB_URL= # e.g. https://github.com/petrnagy/shortlistOS, used by homepage source links
NEXT_PUBLIC_MAGIC_INBOX_DOMAIN= # Domain for Magic Inbox email forwarding (e.g. magic.yourdomain.com)
BETTER_AUTH_SECRET= # Random 32+ char string (can gen with: openssl rand -base64 26 | tr -dc 'a-zA-Z0-9' | head -c 32)

# Fill if you want to use an external database
POSTGRES_URL= # e.g. postgresql://kan:your_password@your_host:5432/kan

# Only required if deploying from compose
POSTGRES_PASSWORD=

# SMTP (optional)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM= # e.g. "Kan <hello@mail.kan.bn>"
FEEDBACK_EMAIL_TO= # e.g. founder@example.com, receives Feedback modal submissions
SMTP_SECURE= # set to "false" to use port 587
SMTP_REJECT_UNAUTHORIZED= # set to "false" to accept invalid certs

# Switch email features off entirely (optional)
NEXT_PUBLIC_DISABLE_EMAIL=

# S3 storage (optional)
S3_REGION= # required for AWS S3 (e.g. us-east-1); ignored by most S3-compatible providers — defaults to us-east-1 if unset
S3_ENDPOINT= # set for S3-compatible providers (MinIO, R2, Spaces, etc.); leave blank for AWS S3
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=
# S3_AVATAR_UPLOAD_LIMIT=2097152 # Avatar upload size limit in bytes (default: 2MB)
NEXT_PUBLIC_STORAGE_URL=
NEXT_PUBLIC_AVATAR_BUCKET_NAME=
NEXT_PUBLIC_ATTACHMENTS_BUCKET_NAME=
SHORTLIST_SOURCE_BUCKET_NAME=
NEXT_PUBLIC_STORAGE_DOMAIN=
NEXT_PUBLIC_USE_VIRTUAL_HOSTED_URLS=


# Auth config (optional)
NEXT_PUBLIC_ALLOW_CREDENTIALS=
NEXT_PUBLIC_DISABLE_SIGN_UP=

# API configuration (optional)
NEXT_API_BODY_SIZE_LIMIT= # e.g. 50mb (defaults to 1mb)

# Integration providers (optional)
TRELLO_APP_API_KEY=
TRELLO_APP_SECRET=

# Proprietary shortlistOS Powerpack checkout (optional, not part of the open-source distribution)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_SHORTLIST_WEBHOOK_SECRET=

# Proprietary shortlistOS Magic endpoints (optional, not part of the open-source distribution)
BREVO_API_KEY=
BREVO_MAGIC_INBOX_WEBHOOK_SECRET=
SHORTLIST_MAGIC_CLIP_WEBHOOK_SECRET=

# Proprietary shortlistOS LLM connector for Powerpack background jobs (optional, not part of the open-source distribution)
LLM_CONNECTOR_API_KEY=
LLM_CONNECTOR_MODEL= # e.g. mistral-small-latest
INBOX_CLIP_RETRY_LIMIT=3
SHORTLIST_LLM_ACCOUNT_DAILY_REQUEST_LIMIT=250
OPENWEBNINJA_API_KEY=
OPENWEBNINJA_RETRY_LIMIT=3
OPENWEBNINJA_WORKER_POLL_INTERVAL_MS=60000
OPENWEBNINJA_SALARY_CACHE_REUSE_DAYS=30
OPENWEBNINJA_ACCOUNT_DAILY_REQUEST_LIMIT=250
FRANKFURTER_BASE_URL=https://api.frankfurter.dev
REGION_SALARY_AVERAGE_COUNTRIES_EU="Germany,France,Italy,Spain,Netherlands"
REGION_SALARY_AVERAGE_COUNTRIES_UK="United Kingdom"
REGION_SALARY_AVERAGE_COUNTRIES_US="United States"
REGION_SALARY_AVERAGE_COUNTRIES_APAC="India,China,Indonesia,Pakistan,Bangladesh,Japan,Philippines,Vietnam,Thailand,South Korea"
REGION_SALARY_AVERAGE_COUNTRIES_GLOBAL="India,China,United States,Indonesia,Pakistan,Nigeria,Brazil,Bangladesh,Russia,Mexico"

# Redis (optional - for rate limiting)
# If not provided, rate limiting will use in-memory storage
REDIS_URL= # e.g. redis://default:your_password@your_host:6379

# shortlistOS Web Clipper API (proprietary Powerpack service)
WEB_CLIPPER_API_URL=http://127.0.0.1:3010
WEB_CLIPPER_API_PORT=3010
WEB_CLIPPER_ACCESS_TOKEN_SECRET= # Random 32+ character signing secret
WEB_CLIPPER_ENCRYPTION_KEY= # Random 32+ character snapshot encryption secret
WEB_CLIPPER_ALLOWED_ORIGINS= # Exact comma-separated chrome-extension:// and moz-extension:// origins

# Logging (optional - debug, info, warn, error; defaults to debug in dev, info in prod)
LOG_LEVEL=

# OAuth providers (optional)
BETTER_AUTH_TRUSTED_ORIGINS=
# Optional: Restrict OIDC/Social sign-ins to specific email domains (comma-separated)
BETTER_AUTH_ALLOWED_DOMAINS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_ISSUER=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
VK_CLIENT_ID=
VK_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
ROBLOX_CLIENT_ID=
ROBLOX_CLIENT_SECRET=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=
