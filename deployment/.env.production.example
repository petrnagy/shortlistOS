# Deployment
# APP_VERSION is supplied by deploy.sh and must not be stored here.
IMAGE_REPOSITORY=ghcr.io/petrnagy/shortlistos
APP_ENV_FILE=.env
WEB_HOST_PORT=3000
CLIPPER_HOST_PORT=3010

# PostgreSQL
POSTGRES_DB=shortlistos
POSTGRES_USER=shortlistos
POSTGRES_PASSWORD=
POSTGRES_URL=

# Redis
REDIS_URL=redis://redis:6379

# Public application configuration
NEXT_PUBLIC_ALLOW_CREDENTIALS=
NEXT_PUBLIC_ATTACHMENTS_BUCKET_NAME=
NEXT_PUBLIC_AVATAR_BUCKET_NAME=
NEXT_PUBLIC_BASE_URL=https://shortlistos.co
NEXT_PUBLIC_DISABLE_EMAIL=
NEXT_PUBLIC_DISABLE_SIGN_UP=
NEXT_PUBLIC_GITHUB_URL=https://github.com/petrnagy/shortlistOS
NEXT_PUBLIC_LANDING_PAGE_URL=https://shortlistos.co
NEXT_PUBLIC_MAGIC_INBOX_DOMAIN=
NEXT_PUBLIC_STORAGE_DOMAIN=
NEXT_PUBLIC_STORAGE_URL=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_USE_VIRTUAL_HOSTED_URLS=
NEXT_PUBLIC_WHITE_LABEL_HIDE_POWERED_BY=

# API
NEXT_API_BODY_SIZE_LIMIT=

# Authentication
BETTER_AUTH_ALLOWED_DOMAINS=
BETTER_AUTH_SECRET=
BETTER_AUTH_TRUSTED_ORIGINS=https://shortlistos.co

# Object storage
S3_ACCESS_KEY_ID=
S3_AVATAR_UPLOAD_LIMIT=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=
S3_REGION=
S3_SECRET_ACCESS_KEY=
SHORTLIST_SOURCE_BUCKET_NAME=

# Web Clipper
WEB_CLIPPER_ACCESS_TOKEN_SECRET=
WEB_CLIPPER_ALLOWED_ORIGINS=
WEB_CLIPPER_API_PORT=3010
WEB_CLIPPER_API_URL=https://api.shortlistos.co
WEB_CLIPPER_ENCRYPTION_KEY=

# Outbound email
SMTP_HOST=
SMTP_PASSWORD=
SMTP_PORT=
SMTP_REJECT_UNAUTHORIZED=
SMTP_SECURE=
SMTP_USER=
EMAIL_FROM=
FEEDBACK_EMAIL_TO=

# Brevo and Magic Inbox
BREVO_API_KEY=
BREVO_MAGIC_INBOX_WEBHOOK_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_SHORTLIST_WEBHOOK_SECRET=

# LLM connector
LLM_CONNECTOR_API_KEY=
LLM_CONNECTOR_MODEL=
INBOX_CLIP_RETRY_LIMIT=3
SHORTLIST_LLM_ACCOUNT_DAILY_REQUEST_LIMIT=250

# OpenWebNinja enrichment
OPENWEBNINJA_ACCOUNT_DAILY_REQUEST_LIMIT=250
OPENWEBNINJA_API_KEY=
OPENWEBNINJA_RETRY_LIMIT=3
OPENWEBNINJA_SALARY_CACHE_REUSE_DAYS=30
OPENWEBNINJA_WORKER_POLL_INTERVAL_MS=60000

# Salary conversion and regional averages
FRANKFURTER_BASE_URL=https://api.frankfurter.dev
REGION_SALARY_AVERAGE_COUNTRIES_APAC="India,China,Indonesia,Pakistan,Bangladesh,Japan,Philippines,Vietnam,Thailand,South Korea"
REGION_SALARY_AVERAGE_COUNTRIES_EU="Germany,France,Italy,Spain,Netherlands"
REGION_SALARY_AVERAGE_COUNTRIES_GLOBAL="India,China,United States,Indonesia,Pakistan,Nigeria,Brazil,Bangladesh,Russia,Mexico"
REGION_SALARY_AVERAGE_COUNTRIES_UK="United Kingdom"
REGION_SALARY_AVERAGE_COUNTRIES_US="United States"

# Legacy integrations
TRELLO_APP_API_KEY=
TRELLO_APP_SECRET=
KAN_ADMIN_API_KEY=
SHORTLIST_MAGIC_CLIP_WEBHOOK_SECRET=

# Social OAuth providers
APPLE_APP_BUNDLE_IDENTIFIER=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_ISSUER=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
ROBLOX_CLIENT_ID=
ROBLOX_CLIENT_SECRET=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
VK_CLIENT_ID=
VK_CLIENT_SECRET=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Logging
LOG_LEVEL=info
