# Compose release coordinates. APP_VERSION is supplied by deploy.sh.
IMAGE_REPOSITORY=ghcr.io/petrnagy/shortlistos

# Private PostgreSQL container. URL-encode special characters in the URL password.
POSTGRES_DB=shortlistos
POSTGRES_USER=shortlistos
POSTGRES_PASSWORD=replace-me
POSTGRES_URL=postgresql://shortlistos:replace-me@postgres:5432/shortlistos

NEXT_PUBLIC_BASE_URL=https://shortlistos.co
NEXT_PUBLIC_LANDING_PAGE_URL=https://shortlistos.co
NEXT_PUBLIC_GITHUB_URL=https://github.com/petrnagy/shortlistOS
WEB_CLIPPER_API_URL=https://api.shortlistos.co
WEB_CLIPPER_API_PORT=3010
BETTER_AUTH_TRUSTED_ORIGINS=https://shortlistos.co

# Copy the remaining application values from .env.example. Never commit the
# populated production file.
